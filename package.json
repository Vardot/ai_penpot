{
  "name": "ai_penpot",
  "private": true,
  "description": "Webship-js (Playwright + Cucumber) BDD suite for the AI Penpot Drupal module: drives a running site to prove the admin settings page, the Penpot connection fields, the AI Agent tools, the permissions and the status report load with no PHP errors.",
  "license": "GPL-2.0",
  "engines": {
    "node": ">= 22.0",
    "yarn": ">= 1.6"
  },
  "keywords": [
    "Drupal",
    "Penpot",
    "Canvas",
    "AI"
  ],
  "author": "Rajab Natshah",
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js tests/step-definitions",
    "generate-reports": "generate-reports"
  },
  "devDependencies": {
    "@cucumber/pretty-formatter": "^3.3",
    "eslint": "~8",
    "eslint-config-prettier": "~8",
    "webship-js": "~2.0"
  },
  "resolutions": {
    "@cucumber/pretty-formatter": "^3.3"
  }
}
